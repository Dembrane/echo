{
  "name": "@dembrane/platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/parity",
    "legacy/ops"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.local --filter @dembrane/api dev",
    "check": "bun run lint && bun run typecheck && bun run packages check && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "bun --filter @dembrane/db generate",
    "db:migrate": "bun --env-file=.env.local packages/db/src/migrate.ts",
    "setup": "scripts/setup.sh",
    "config": "bun packages/config/src/cli.ts",
    "packages": "bun scripts/package-map.ts",
    "test": "bun test --parallel",
    "test:changed": "bun test --parallel --changed=origin/feat/bun-migration",
    "seed:verification-topics": "bun --env-file=.env.local packages/verify/src/seed-cli.ts",
    "seed:accounts-demo": "bun --env-file=.env.local packages/accounts/src/seed-cli.ts",
    "accounts:staff-key": "bun --env-file=.env.local packages/accounts/src/staff-key-cli.ts",
    "translations:fill": "bun packages/i18n/src/cli.ts --write",
    "translations:check": "bun packages/i18n/src/cli.ts",
    "staff:access": "bun --env-file=.env.local packages/staff/src/grant-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
