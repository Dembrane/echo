{
  "env": "next",
  "deploy_ref": "refs/heads/main",
  "browser_origins": [
    "https://dashboard.staging.dembrane.com",
    "https://portal.staging.dembrane.com"
  ],
  "db_tier": "db-custom-1-3840",
  "alert_email": "sameer@dembrane.com",
  "db_max_connections": 100,
  "services": {
    "api": {
      "min": 2,
      "max": 2,
      "concurrency": 1000,
      "cpu": "1",
      "memory": "1Gi",
      "cpu_always": true
    },
    "dashboard": { "min": 2, "max": 2, "concurrency": 1000, "cpu": "1", "memory": "512Mi" },
    "portal": { "min": 2, "max": 2, "concurrency": 1000, "cpu": "1", "memory": "512Mi" },
    "media": { "min": 0, "max": 4, "concurrency": 1, "cpu": "2", "memory": "4Gi" },
    "worker": { "min": 2, "max": 2, "cpu": "1", "memory": "1Gi" }
  }
}
