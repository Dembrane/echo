[
  {
    "id": "arguments",
    "version": "arguments-v1",
    "hashVersion": "c14n-v1",
    "inputTypes": [],
    "outputTypes": ["argument"],
    "steps": [
      {
        "key": "load",
        "version": "1",
        "kind": "deterministic",
        "description": "Read the transcripts and check them against the pinned text hashes",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      },
      {
        "key": "extract",
        "version": "1",
        "kind": "model",
        "description": "Extract arguments and claims from one conversation, window by window",
        "promptRef": "dembrane/map/prompts/map-arguments-v2.md",
        "promptVersion": "map-arguments-v2",
        "checkVersion": null
      },
      {
        "key": "ground",
        "version": "1",
        "kind": "check",
        "description": "Keep items with a known kind and valence and a quote found verbatim in their transcript",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": "ground-quote-v1"
      },
      {
        "key": "merge",
        "version": "1",
        "kind": "deterministic",
        "description": "One candidate per source item across overlapping windows",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      },
      {
        "key": "embed",
        "version": "1",
        "kind": "deterministic",
        "description": "Embed each statement's projection, reusing stored vectors",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      }
    ],
    "validationRules": [
      "every argument has a statement, a kind and a valence",
      "every argument has at least one quote found verbatim in its conversation",
      "every statement's vector is durable before publication"
    ],
    "identityPolicy": {
      "kind": "lineage-key",
      "description": "An argument keeps its identity while its conversation and extracted item (kind and normalised statement) stay the same; a reworded statement is a new object."
    },
    "embeddingProjections": {
      "argument": "statement-v1"
    },
    "name": "Arguments",
    "purpose": "Extract complete, source-grounded arguments and claims from every conversation in the project, keeping distinct arguments separate.",
    "parametersSchema": null,
    "outputSchemas": {
      "argument": {
        "id": "argument",
        "schemaVersion": 1,
        "description": "A complete, source-grounded argument or claim from a transcript.",
        "payloadSchema": {
          "$defs": {
            "Evidence": {
              "additionalProperties": false,
              "description": "Quotes from one conversation, as the Map manifest records them.",
              "properties": {
                "conversationId": {
                  "minLength": 1,
                  "title": "Conversationid",
                  "type": "string"
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Label"
                },
                "createdAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Createdat"
                },
                "quotes": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Quotes",
                  "type": "array"
                }
              },
              "required": ["conversationId"],
              "title": "Evidence",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "statement": {
              "minLength": 1,
              "title": "Statement",
              "type": "string"
            },
            "epistemicKind": {
              "enum": ["argument", "claim"],
              "title": "Epistemickind",
              "type": "string"
            },
            "valence": {
              "anyOf": [
                {
                  "enum": ["positive", "negative", "neutral"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Valence"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "title": "Evidence",
              "type": "array"
            }
          },
          "required": ["statement", "epistemicKind"],
          "title": "ArgumentPayload",
          "type": "object"
        },
        "mapCapable": true,
        "embeddingProjectionVersion": "statement-v1",
        "factCheckable": true
      }
    },
    "scopeKeyPattern": "^project$",
    "maxRunning": null,
    "modelConcurrency": 6
  },
  {
    "id": "deduplicated_arguments",
    "version": "dedup-v2",
    "hashVersion": "c14n-v1",
    "inputTypes": ["argument"],
    "outputTypes": ["deduplicated_argument"],
    "steps": [
      {
        "key": "discover",
        "version": "1",
        "kind": "deterministic",
        "description": "Propose candidate groups by complete linkage on statement embeddings, within one kind and valence",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      },
      {
        "key": "verify",
        "version": "1",
        "kind": "model",
        "description": "Verify one candidate group: sub-groups, each proposed statement checked against every member",
        "promptRef": "dembrane/analysis/prompts/dedup-verify-v2.md",
        "promptVersion": "dedup-verify-v2",
        "checkVersion": null
      },
      {
        "key": "assemble",
        "version": "1",
        "kind": "check",
        "description": "Merge only fully verified sub-groups and account for every input revision exactly once",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": "dedup-accounting-v1"
      },
      {
        "key": "embed",
        "version": "1",
        "kind": "deterministic",
        "description": "Embed each output statement, reusing stored vectors",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      }
    ],
    "validationRules": [
      "embedding similarity proposes candidates, never equivalence",
      "a merge needs an equivalent sub-group of one kind and valence, checked against every member",
      "every input revision is in exactly one output, with a derived_from relation to it",
      "unverified candidate groups stay apart and are listed in the coverage check"
    ],
    "identityPolicy": {
      "kind": "lineage-key",
      "description": "An output keeps its identity while it stands for the same set of source argument objects."
    },
    "embeddingProjections": {
      "deduplicated_argument": "statement-v1"
    },
    "name": "Deduplicated arguments",
    "purpose": "Consolidate arguments that say the same thing into one argument each, verified against every member and derived from each; distinct and minority arguments pass through.",
    "parametersSchema": {
      "additionalProperties": false,
      "properties": {
        "similarity_threshold": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Threshold"
        },
        "max_group_size": {
          "default": 8,
          "maximum": 64,
          "minimum": 2,
          "title": "Max Group Size",
          "type": "integer"
        },
        "max_candidate_groups": {
          "default": 250,
          "maximum": 5000,
          "minimum": 0,
          "title": "Max Candidate Groups",
          "type": "integer"
        }
      },
      "title": "DeduplicationParameters",
      "type": "object"
    },
    "outputSchemas": {
      "deduplicated_argument": {
        "id": "deduplicated_argument",
        "schemaVersion": 1,
        "description": "An argument consolidating equivalent source arguments, derived from each.",
        "payloadSchema": {
          "$defs": {
            "Consolidation": {
              "additionalProperties": false,
              "description": "How a deduplicated argument came to be: its members are `derived_from`\nrelations; this records the strategy, coverage and verification.",
              "properties": {
                "strategy": {
                  "minLength": 1,
                  "title": "Strategy",
                  "type": "string"
                },
                "memberCount": {
                  "minimum": 1,
                  "title": "Membercount",
                  "type": "integer"
                },
                "verification": {
                  "enum": ["verified", "singleton", "uncertain"],
                  "title": "Verification",
                  "type": "string"
                },
                "rationale": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Rationale"
                },
                "coverage": {
                  "additionalProperties": true,
                  "title": "Coverage",
                  "type": "object"
                }
              },
              "required": ["strategy", "memberCount", "verification"],
              "title": "Consolidation",
              "type": "object"
            },
            "Evidence": {
              "additionalProperties": false,
              "description": "Quotes from one conversation, as the Map manifest records them.",
              "properties": {
                "conversationId": {
                  "minLength": 1,
                  "title": "Conversationid",
                  "type": "string"
                },
                "label": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Label"
                },
                "createdAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Createdat"
                },
                "quotes": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Quotes",
                  "type": "array"
                }
              },
              "required": ["conversationId"],
              "title": "Evidence",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "statement": {
              "minLength": 1,
              "title": "Statement",
              "type": "string"
            },
            "epistemicKind": {
              "enum": ["argument", "claim"],
              "title": "Epistemickind",
              "type": "string"
            },
            "valence": {
              "anyOf": [
                {
                  "enum": ["positive", "negative", "neutral"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Valence"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "title": "Evidence",
              "type": "array"
            },
            "consolidation": {
              "$ref": "#/$defs/Consolidation"
            }
          },
          "required": ["statement", "epistemicKind", "consolidation"],
          "title": "DeduplicatedArgumentPayload",
          "type": "object"
        },
        "mapCapable": true,
        "embeddingProjectionVersion": "statement-v1",
        "factCheckable": true
      }
    },
    "scopeKeyPattern": "^project$",
    "maxRunning": null,
    "modelConcurrency": 4
  },
  {
    "id": "integration.fixture_delivery",
    "version": "integration-fixture-v1",
    "hashVersion": "c14n-v1",
    "inputTypes": ["argument", "deduplicated_argument", "tension"],
    "outputTypes": ["integration.delivery_payload"],
    "steps": [
      {
        "key": "collect",
        "version": "1",
        "kind": "deterministic",
        "description": "Project each selected revision into one delivery item",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      },
      {
        "key": "render",
        "version": "1",
        "kind": "deterministic",
        "description": "Assemble the request body and its content-derived idempotency key",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": null
      },
      {
        "key": "validate",
        "version": "1",
        "kind": "check",
        "description": "The body matches the destination's declared shape and every item names a pinned revision",
        "promptRef": null,
        "promptVersion": null,
        "checkVersion": "delivery-body-v1"
      }
    ],
    "validationRules": [
      "every item names a revision this run pinned",
      "a selection above the destination's limit fails the check rather than being cut to fit",
      "the payload is built and stored; delivering it is a separate action with its own authorization"
    ],
    "identityPolicy": {
      "kind": "lineage-key",
      "description": "One payload object per destination scope: each run appends a revision, so a destination's history is its revisions."
    },
    "embeddingProjections": {},
    "name": "Delivery payload (integration fixture)",
    "purpose": "Turn selected arguments, deduplicated arguments and tensions into a schema-validated request body for an external destination. It builds the payload and sends nothing.",
    "parametersSchema": {
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "title": "DeliveryParameters",
      "type": "object"
    },
    "outputSchemas": {
      "integration.delivery_payload": {
        "id": "integration.delivery_payload",
        "schemaVersion": 1,
        "description": "A request body for an external destination, built from selected object revisions. It has no Map projection and no embedding, and generating it sends nothing.",
        "payloadSchema": {
          "$defs": {
            "DeliveryBody": {
              "additionalProperties": false,
              "description": "Shaped like the request body of an external API, not sent by this recipe.",
              "properties": {
                "destination": {
                  "minLength": 1,
                  "title": "Destination",
                  "type": "string"
                },
                "schemaVersion": {
                  "minimum": 1,
                  "title": "Schemaversion",
                  "type": "integer"
                },
                "idempotencyKey": {
                  "minLength": 1,
                  "title": "Idempotencykey",
                  "type": "string"
                },
                "projectId": {
                  "minLength": 1,
                  "title": "Projectid",
                  "type": "string"
                },
                "counts": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Counts",
                  "type": "object"
                },
                "items": {
                  "items": {
                    "$ref": "#/$defs/DeliveryItem"
                  },
                  "title": "Items",
                  "type": "array"
                }
              },
              "required": ["destination", "schemaVersion", "idempotencyKey", "projectId"],
              "title": "DeliveryBody",
              "type": "object"
            },
            "DeliveryItem": {
              "additionalProperties": false,
              "properties": {
                "externalId": {
                  "minLength": 1,
                  "title": "Externalid",
                  "type": "string"
                },
                "type": {
                  "enum": ["argument", "deduplicated_argument", "tension"],
                  "title": "Type",
                  "type": "string"
                },
                "title": {
                  "minLength": 1,
                  "title": "Title",
                  "type": "string"
                },
                "body": {
                  "minLength": 1,
                  "title": "Body",
                  "type": "string"
                },
                "question": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Question"
                },
                "sources": {
                  "items": {
                    "$ref": "#/$defs/DeliverySource"
                  },
                  "title": "Sources",
                  "type": "array"
                },
                "revision": {
                  "$ref": "#/$defs/DeliveryRevision"
                }
              },
              "required": ["externalId", "type", "title", "body", "revision"],
              "title": "DeliveryItem",
              "type": "object"
            },
            "DeliveryRevision": {
              "additionalProperties": false,
              "description": "What the receiver needs to cite the exact content it was sent.",
              "properties": {
                "objectId": {
                  "minLength": 1,
                  "title": "Objectid",
                  "type": "string"
                },
                "revisionId": {
                  "minLength": 1,
                  "title": "Revisionid",
                  "type": "string"
                },
                "recipeId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Recipeid"
                },
                "recipeVersion": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Recipeversion"
                }
              },
              "required": ["objectId", "revisionId"],
              "title": "DeliveryRevision",
              "type": "object"
            },
            "DeliverySource": {
              "additionalProperties": false,
              "properties": {
                "conversationId": {
                  "minLength": 1,
                  "title": "Conversationid",
                  "type": "string"
                },
                "quote": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Quote"
                }
              },
              "required": ["conversationId"],
              "title": "DeliverySource",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "minLength": 1,
              "title": "Endpoint",
              "type": "string"
            },
            "method": {
              "const": "POST",
              "title": "Method",
              "type": "string"
            },
            "contentType": {
              "const": "application/json",
              "title": "Contenttype",
              "type": "string"
            },
            "body": {
              "$ref": "#/$defs/DeliveryBody"
            }
          },
          "required": ["endpoint", "method", "contentType", "body"],
          "title": "DeliveryPayload",
          "type": "object"
        },
        "mapCapable": false,
        "embeddingProjectionVersion": null,
        "factCheckable": false
      }
    },
    "scopeKeyPattern": "^delivery:[a-z0-9][a-z0-9-]{0,39}$",
    "maxRunning": null,
    "modelConcurrency": 4
  },
