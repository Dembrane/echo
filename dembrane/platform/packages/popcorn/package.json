  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.1.10",
    "@dembrane/access": "workspace:*",
    "@dembrane/analysis": "workspace:*",
    "@dembrane/analytics": "workspace:*",
    "@dembrane/core": "workspace:*",
    "@dembrane/db": "workspace:*",
    "@dembrane/http": "workspace:*",
    "@dembrane/legacy-shape": "workspace:*",
    "@dembrane/llm": "workspace:*",
    "@dembrane/observability": "workspace:*",
    "@dembrane/queue": "workspace:*",
    "@dembrane/ratelimit": "workspace:*",
    "@dembrane/realtime": "workspace:*",
    "hono": "^4.9.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@dembrane/config": "workspace:*"
  }
}
