{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-prototype-v1",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "ProjectConfig", "name": "ProjectConfig" }]
  },
  "main": "src/server/server.ts",
  "migrations": [
    {
      "new_sqlite_classes": ["ProjectConfig"],
      "tag": "v1"
    }
  ],
  // The same names and defaults as the dashboard's dev proxy (dembrane/frontend/vite.config.ts).
  // .dev.vars overrides them.
  "vars": {
    "VITE_DEV_API_PROXY": "http://localhost:8080/",
    "DASHBOARD_URL": "http://localhost:5173"
  }
}
