{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"includes": [
			"**/*",
			"!**/dist",
			"!**/node_modules",
			"!**/package-lock.json",
			"!**/package.json",
			"!**/locales",
			"!**/features/accounts/contract",
			"!**/lib/errors/catalog"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"noUndeclaredDependencies": "error",
				"noUnusedVariables": "error",
				"useUniqueElementIds": "off"
			},
			"nursery": {
				"useReactCompiler": "error"
			},
			"style": {
				"noInferrableTypes": "error",
				"noParameterAssign": "error",
				"noUnusedTemplateLiteral": "error",
				"useArrayLiterals": "error",
				"useAsConstAssertion": "error",
				"useCollapsedElseIf": "error",
				"useConst": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useNumberNamespace": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"useTemplate": "error"
			},
			"suspicious": {
				"noAlert": "warn",
				"noCatchAssign": "error",
				"noVar": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/**",
				"!src/portal/**",
				"!src/Router.tsx",
				"!src/e2e/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/portal",
											"@/portal/**",
											"**/portal",
											"**/portal/**",
											"!./portal",
											"!./portal/**"
										],
										"message": "The participant portal (src/portal) is on its way to being its own app, so nothing outside it may import from it. Move what both need into shared code instead; only Router.tsx mounts the portal."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/portal/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../../*", "../../../**"],
										"message": "Import with an @/ alias instead of climbing three or more folders: @/portal/... inside the portal, @/components/..., @/hooks/... or @/lib/... outside it. Deep relative paths break silently when files move."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/components/announcement/hooks/index.ts",
				"src/components/canvas/CanvasFrame.tsx",
				"src/components/chat/AgenticChatPanel.tsx",
				"src/components/chat/AgenticPlanCard.tsx",
				"src/components/chat/ProjectUpdateSuggestionCard.tsx",
				"src/components/chat/TemplatesModal.tsx",
				"src/components/common/BeautifulLoading/index.tsx",
				"src/components/common/ExponentialProgress.tsx",
				"src/components/common/InputModal.tsx",
				"src/components/conversation/ConversationAccordion.tsx",
				"src/components/conversation/ConversationDrilldownModal.tsx",
				"src/components/conversation/ConversationEdit.tsx",
				"src/components/conversation/FunnelCanvas.tsx",
				"src/components/conversation/LiveMonitorSection.tsx",
				"src/components/conversation/MoveConversationButton.tsx",
				"src/components/conversation/RetranscribeConversation.tsx",
				"src/components/conversation/useChunkAnchorScroll.ts",
				"src/components/dropzone/UploadConversationDropzone.tsx",
				"src/components/goal/ProjectGoalSection.tsx",
				"src/components/invite/InviteModal.tsx",
				"src/components/layout/WorkspaceLayout.tsx",
				"src/components/map/renderers/LocalMapGraph.tsx",
				"src/components/map/renderers/MstGraph.tsx",
				"src/components/methodology/WorkspaceMethodologiesSection.tsx",
				"src/components/popcorn/PopcornStart.tsx",
				"src/components/popcorn/SettingsSaveContext.tsx",
				"src/components/present/hooks/usePresentationDraft.ts",
				"src/components/pricing/PricingTextInput.tsx",
				"src/components/report/ReportEditor.tsx",
				"src/components/report/ReportFocusSelector.tsx",
				"src/components/results/ResultRow.tsx",
				"src/components/results/ResultsList.tsx",
				"src/components/results/curate/CuratePanel.tsx",
				"src/components/results/feedback/useResultFeedback.ts",
				"src/components/settings/AccountSettingsCard.tsx",
				"src/components/settings/AuditLogsCard.tsx",
				"src/components/settings/LegalBasisCard.tsx",
				"src/components/settings/TwoFactorSettingsCard.tsx",
				"src/components/voice/useVoiceRecorder.ts",
				"src/components/workspace/DowngradeBanner.tsx",
				"src/components/workspace/OrganisationUsageRollup.tsx",
				"src/features/accounts/customer/room/AddPersonSteps.tsx",
				"src/features/sidebar/animations/ViewTransition.tsx",
				"src/features/sidebar/blocks/SearchBlock.tsx",
				"src/features/sidebar/hooks/useRecents.ts",
				"src/features/sidebar/hooks/useSearchHits.ts",
				"src/features/sidebar/shell/MobileSidebarAutoClose.tsx",
				"src/features/sidebar/shell/useSidebarWhitelabelLogo.ts",
				"src/hooks/useAutoSave.ts",
				"src/hooks/useConversationMonitor.ts",
				"src/hooks/useCopyToRichText.ts",
				"src/hooks/useLanguage.ts",
				"src/hooks/useLoadNotification.ts",
				"src/hooks/useVideoWakeLockFallback.ts",
				"src/hooks/useWakeLock.ts",
				"src/routes/admin/AdminSettingsRoute.tsx",
				"src/routes/auth/Login.tsx",
				"src/routes/onboarding/OnboardingRoute.tsx",
				"src/routes/project/HostGuidePage.tsx",
				"src/routes/project/chat/ProjectChatRoute.tsx",
				"src/routes/project/present/PresentRoute.tsx",
				"src/routes/project/report/ProjectReportRoute.tsx",
				"src/routes/settings/AgentConsentRoute.tsx",
				"src/routes/workspaces/CreateWorkspaceRoute.tsx",
				"src/routes/workspaces/WorkspaceSettingsRoute.tsx"
			],
			"linter": {
				"rules": {
					"nursery": {
						"useReactCompiler": "warn"
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
