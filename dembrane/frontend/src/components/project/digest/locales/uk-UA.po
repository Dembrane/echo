msgstr "Додати з файлу"

#: src/components/project/digest/NameStepDigest/NameStepDigestConnected.tsx:106
msgid "Added what the session is about to the project context. Check it above."
msgstr "Про що сесія, тепер є в контексті проєкту. Перевір це вище."

#: src/components/project/digest/DigestReview/DigestReview.tsx:314
msgid "All templates"
msgstr "Усі шаблони"

#: src/components/project/digest/DigestReview/DigestReview.tsx:281
msgid "Also fits:"
msgstr "Також підходить:"

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:197
msgid "An invitation or project page. dembrane reads it once."
msgstr "Запрошення або сторінка проєкту. dembrane прочитає її один раз."

#: src/components/project/digest/DigestProgress/DigestProgress.tsx:59
msgid "Cancel"
msgstr "Скасувати"

#: src/components/project/digest/DigestReview/DigestReview.tsx:108
msgid "Check each part, change what's off and switch off what you don't want. Nothing is saved until you create the project."
msgstr "Перевір кожну частину, зміни те, що не так, і вимкни те, що не потрібно. Нічого не зберігається, доки ти не створиш проєкт."

#: src/components/project/digest/DigestConnected.tsx:204
msgid "Choose a template below to continue."
msgstr "Обери шаблон нижче, щоб продовжити."

