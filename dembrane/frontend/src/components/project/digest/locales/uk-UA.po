msgid "Steps for this session, added after the template's host script."
msgstr "Кроки для цієї сесії, додані після сценарію ведучого з шаблону."

#: src/components/project/digest/DigestReview/DigestReview.tsx:245
msgid "Template"
msgstr "Шаблон"

#: src/components/project/digest/DigestReview/DigestReview.tsx:149
msgid "The link could not be read, so this comes from your files and text."
msgstr "Посилання не вдалося прочитати, тож це взято з твоїх файлів і тексту."

#: src/components/project/digest/messages.ts:23
msgid "There is no text in this file."
msgstr "У цьому файлі немає тексту."

#: src/components/project/digest/messages.ts:25
msgid "This file couldn't be opened. It may be damaged or protected with a password."
msgstr "Цей файл не вдалося відкрити. Можливо, він пошкоджений або захищений паролем."

#: src/components/project/digest/messages.ts:19
msgid "This kind of file can't be read. PDF, Word (.docx), PowerPoint (.pptx) and text files work."
msgstr "Такий файл не можна прочитати. Працюють PDF, Word (.docx), PowerPoint (.pptx) і текстові файли."

#: src/components/project/digest/messages.ts:13
msgid "This older format can't be read here. Save it as PDF, .docx or .pptx and drop it again."
msgstr "Цей старіший формат тут не читається. Збережи як PDF, .docx або .pptx і перетягни знову."

#: src/components/project/digest/messages.ts:21
msgid "This PDF is a scan, so there is no text to read. Paste the text, or drop a version you can select text in."
msgstr "Цей PDF є сканом, тож тексту для читання немає. Встав текст або перетягни версію, де текст можна виділити."

#: src/components/project/digest/DigestProgress/DigestProgress.tsx:47
msgid "This takes up to half a minute for long documents."
msgstr "Для довгих документів це займає до пів хвилини."

