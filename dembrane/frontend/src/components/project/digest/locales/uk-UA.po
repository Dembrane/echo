msgid "Choose the template that fits the session."
msgstr "Обери шаблон, що підходить до сесії."

#: src/components/project/digest/DigestReview/DigestReview.tsx:138
msgid "Contact details and lists of names were left out of the context."
msgstr "Контактні дані та списки імен не потрапили в контекст."

#: src/components/project/digest/DigestReview/DigestReview.tsx:471
msgid "Create project"
msgstr "Створити проєкт"

#: src/components/project/digest/NameStepDigest/NameStepDigestConnected.tsx:99
msgid "dembrane couldn't read anything to add from this."
msgstr "dembrane не змогла знайти тут нічого, що можна додати."

#: src/components/project/digest/DigestConnected.tsx:196
msgid "dembrane couldn't set the project up from this."
msgstr "dembrane не змогла налаштувати проєкт за цим матеріалом."

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:128
msgid "Drop files here, or choose them"
msgstr "Перетягни файли сюди або обери їх"

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:112
msgid "Drop files or choose them"
msgstr "Перетягни файли або обери їх"

#: src/components/project/digest/DigestConnected.tsx:173
msgid "Drop it to set up the project from it"
msgstr "Відпусти, щоб налаштувати проєкт за цим"

#: src/components/project/digest/DigestReview/DigestReview.tsx:407
#: src/components/project/digest/DigestReview/DigestReview.tsx:414
msgid "Explore question"
msgstr "Питання Explore"

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:228
msgid "Files stay on your device. Only their text is sent to dembrane's model provider to prepare the setup. Don't drop material you may not share."
msgstr "Файли залишаються на твоєму пристрої. Лише їхній текст надсилається постачальнику моделей dembrane, щоб підготувати налаштування. Не додавай матеріали, якими не можна ділитися."

