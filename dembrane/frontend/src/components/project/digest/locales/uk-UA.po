msgid "Not read: together the files are longer than 200,000 characters."
msgstr "Не прочитано: разом файли довші за 200 000 символів."

#: src/components/project/digest/DigestConnected.tsx:209
msgid "Only its start fits: dembrane reads the first 4,000 characters of the context."
msgstr "Вміщується лише початок: dembrane читає перші 4000 символів контексту."

#: src/components/project/digest/DigestReview/DigestReview.tsx:313
msgid "Or choose another"
msgstr "Або обери інший"

#: src/components/project/digest/DigestReview/DigestReview.tsx:333
msgid "Participants tap the round they are in before they record."
msgstr "Учасники торкаються свого раунду перед записом."

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:157
msgid "Paste text"
msgstr "Вставити текст"

#: src/components/project/digest/DigestEntry/DigestEntry.tsx:183
msgid "Paste the agenda, the invitation or the brief."
msgstr "Встав порядок денний, запрошення або бриф."

