              "enum": ["argument", "deduplicated_argument", "tension"],
              "title": "Type",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "body": {
              "minLength": 1,
              "title": "Body",
              "type": "string"
