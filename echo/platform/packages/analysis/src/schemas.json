            "recipeVersion": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Recipeversion"
            }
          },
          "required": ["objectId", "revisionId"],
          "title": "DeliveryRevision",
          "type": "object"
        },
        "DeliverySource": {
          "additionalProperties": false,
          "properties": {
            "conversationId": {
              "minLength": 1,
              "title": "Conversationid",
              "type": "string"
