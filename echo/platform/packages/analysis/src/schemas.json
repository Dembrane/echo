        "method": {
          "const": "POST",
          "title": "Method",
          "type": "string"
        },
        "contentType": {
          "const": "application/json",
          "title": "Contenttype",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/DeliveryBody"
        }
      },
      "required": ["endpoint", "method", "contentType", "body"],
      "title": "DeliveryPayload",
      "type": "object"
