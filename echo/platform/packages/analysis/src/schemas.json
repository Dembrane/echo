                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Question"
            },
            "sources": {
              "items": {
                "$ref": "#/$defs/DeliverySource"
              },
              "title": "Sources",
              "type": "array"
            },
            "revision": {
              "$ref": "#/$defs/DeliveryRevision"
            }
          },
          "required": ["externalId", "type", "title", "body", "revision"],
          "title": "DeliveryItem",
          "type": "object"
