        "DeliveryRevision": {
          "additionalProperties": false,
          "description": "What the receiver needs to cite the exact content it was sent.",
          "properties": {
            "objectId": {
              "minLength": 1,
              "title": "Objectid",
              "type": "string"
            },
            "revisionId": {
              "minLength": 1,
