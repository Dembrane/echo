{
  "env": "prod",
  "deploy_ref": "refs/heads/main",
  "browser_origins": ["https://dashboard.dembrane.com", "https://portal.dembrane.com"],
  "db_tier": "db-custom-2-8192",
  "db_max_connections": 400,
  "services": {
    "api": {
      "min": 2,
      "max": 10,
      "concurrency": 1000,
      "cpu": "1",
      "memory": "1Gi",
      "cpu_always": true
    },
    "dashboard": { "min": 2, "max": 4, "concurrency": 1000, "cpu": "1", "memory": "512Mi" },
    "portal": { "min": 2, "max": 4, "concurrency": 1000, "cpu": "1", "memory": "512Mi" },
    "media": { "min": 1, "max": 20, "concurrency": 1, "cpu": "2", "memory": "4Gi" },
    "worker": { "min": 4, "max": 4, "cpu": "1", "memory": "1Gi" }
  }
}
