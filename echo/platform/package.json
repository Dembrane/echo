{
  "name": "@echo/platform",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @echo/api dev",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "db:generate": "bun --filter @echo/db generate",
    "db:migrate": "bun --filter @echo/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
