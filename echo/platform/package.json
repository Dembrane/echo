{
  "name": "@echo/platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "parity"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.local --filter @echo/api dev",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "db:generate": "bun --filter @echo/db generate",
    "db:migrate": "bun --env-file=.env.local packages/db/src/migrate.ts",
    "setup": "scripts/setup.sh",
    "config": "bun packages/config/src/cli.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
