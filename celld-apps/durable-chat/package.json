{
  "name": "durable-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist",
    "check": "tsc --project src/client && tsc --project src/server",
    "dev": "pnpm run build && celld dev",
    "deploy": "pnpm run build && ../../echo/scripts/remote-dev/celld-deploy.sh ."
  },
  "dependencies": {
    "nanoid": "5.1.5",
    "partyserver": "0.0.66",
    "partysocket": "1.1.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router": "7.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "typescript": "5.8.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["esbuild"]
  }
}
